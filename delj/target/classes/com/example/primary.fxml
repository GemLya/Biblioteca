<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.PrimaryController">
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
   <children>
      <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Gestión de Biblioteca (SQL Server)" />
      
      <HBox spacing="10.0" alignment="CENTER_LEFT">
         <children>
            <TextField fx:id="txtTitulo" promptText="Título del libro" HBox.hgrow="ALWAYS" />
            <TextField fx:id="txtAutor" promptText="Autor" HBox.hgrow="ALWAYS" />
            <CheckBox fx:id="chkDisponible" text="Disponible" selected="true" />
            <Button text="Guardar" onAction="#guardarLibro" style="-fx-background-color: #28a745; -fx-text-fill: white;" />
            <Button text="Eliminar" onAction="#eliminarLibro" style="-fx-background-color: #dc3545; -fx-text-fill: white;" />
         </children>
      </HBox>

      <TableView fx:id="tablaLibros" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
          <TableColumn fx:id="colTitulo" prefWidth="200.0" text="Título" />
            <TableColumn fx:id="colAutor" prefWidth="150.0" text="Autor" />
            <TableColumn fx:id="colDisponible" prefWidth="100.0" text="Disponible" />
        </columns>
      </TableView>
   </children>
</VBox>